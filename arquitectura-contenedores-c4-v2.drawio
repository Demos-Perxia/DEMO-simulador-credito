ative="1" as="geometry"/></mxCell><mxCell id="e5" value="usa puertos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#D81F3A;" edge="1" parent="1" source="application" target="infrastructure"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Dependencias&lt;/b&gt;&lt;br&gt;Domain no conoce HTTP, DI, configuración ni UI. Application depende de puertos; Infrastructure los implementa. Sin persistencia ni llamadas a terceros en esta versión." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7F8;strokeColor=#F1B7C1;fontColor=#4A1820;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="660" width="650" height="85" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>